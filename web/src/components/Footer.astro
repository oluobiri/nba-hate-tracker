---
import { PRODUCTION_DATA_BASE } from '../data/env'
import { AUTHOR, COFFEE_URL, CURRENT_SEASON, GITHUB_URL, LINKEDIN_URL } from '../site'

const manifestUrl = `${PRODUCTION_DATA_BASE}/season=${CURRENT_SEASON}/manifest.json`
---

<footer class="ftr">
  <div class="wrap ftr__wrap">
    <p class="ftr__method">
      Every r/NBA comment about a tracked player, classified negative, neutral or positive. Rates are counts ÷ total.
      <a href="/how-it-works/">How it works</a>
    </p>
    <p class="ftr__links">
      <a href={manifestUrl}>Data</a>
      <a href={GITHUB_URL}>GitHub</a>
      <span>
        Built by {LINKEDIN_URL ? <a href={LINKEDIN_URL}>{AUTHOR}</a> : AUTHOR}
      </span>
      <a class="ftr__coffee" href={COFFEE_URL}>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 5h9v5a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z" />
          <path d="M11 6.5h1.25a1.75 1.75 0 0 1 0 3.5H11" />
          <path d="M1.5 15h12" />
        </svg>
        Buy me a coffee
      </a>
    </p>
  </div>
</footer>
