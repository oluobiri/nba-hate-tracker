---
// One recap's page. The header, the periods, the night against his usual
// and the method are HTML at build; the replay is one island that fetches
// the recap file and plays the room on the wall clock.
import type { InferGetStaticPropsType } from 'astro'

import { cardHref } from '../../cards/model'
import { GameLine } from '../../components/GameLine'
import { GameScatter } from '../../components/GameScatter'
import { MethodNote } from '../../components/MethodNote'
import { PeriodStrip } from '../../components/PeriodStrip'
import { RecapReplay } from '../../components/RecapReplay'
import { VerdictDelta } from '../../components/VerdictDelta'
import { getSeason } from '../../data'
import Base from '../../layouts/Base.astro'
import { buildGameLog, SCATTER_MIN, scatterLead, scatterPoints } from '../../lib/games'
import { headshotSrcSet } from '../../lib/media'
import { negRate, pearson } from '../../lib/metrics'
import { boxLine, buildRecaps, countsLine, gamePhrase, lagPhrase, nextRecap, nightSentence, recapHref } from '../../lib/recaps'
import { REPLAY_KEYS } from '../../lib/url'

export async function getStaticPaths() {
  const { manifest, tables } = await getSeason()
  const recaps = buildRecaps(manifest, tables)
  return recaps.map((recap) => ({ params: { key: recap.key }, props: { recap, next: nextRecap(recaps, recap.key) } }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { recap, next } = Astro.props
const { manifest, tables } = await getSeason()
const name = recap.entry.attributed_player
const headshot = recap.player.headshot_url
const floor = manifest.rules.floors.game_min_n
const lagSeconds = manifest.rules.recaps.reaction_lag.median_offset_seconds
const lag = lagPhrase(lagSeconds)
const title = `${name} · ${recap.line.game ?? recap.line.date}`
const verdict = nightSentence(name, recap.night, recap.usual, floor)
const flairAbbr = Object.fromEntries(tables.teams.map((t) => [t.team, t.abbreviation]))
// PROTOTYPE: the apron around the court tinted by the right-now mix. Judge it on a phone before it ships.
const CROWD_TINT = false
// Where the night sits among his games: the player page's scatter, this game ringed.
const abbr = new Map(tables.teams.map((t) => [t.team, t.abbreviation]))
const gamesById = new Map(tables.games.map((g) => [g.game_id, g]))
const log = buildGameLog(
  tables.player_games.filter((r) => r.attributed_player === name),
  tables.game_sentiment.filter((r) => r.attributed_player === name),
  gamesById,
  abbr,
  recap.usual,
  floor,
)
const points = scatterPoints(log)
const r = pearson(
  points.map((p) => p.x),
  points.map((p) => p.y),
)
---

<Base title={title} description={recap.hook} image={cardHref.recap(recap.key)}>
  <script is:inline define:vars={{ replay: REPLAY_KEYS }}>
    // A deep link carries a moment: hold the replay's prerendered frame out
    // of sight until the island has the file and has read the URL.
    const q = new URLSearchParams(location.search)
    if (replay.some((k) => q.has(k))) document.documentElement.classList.add('has-replay-view')
  </script>
  <main id="main" class="wrap page rp">
    <header class="rp__head">
      <div class="rp__head-text">
        <p class="eyebrow"><a class="rp__up" href="/recaps/">Recaps</a> · <GameLine parts={recap.line} /></p>
        <h1 class={`rp__name rp__name--${recap.tone}`}>{name}</h1>
        <p class="rp__hook">{recap.hook}</p>
        <p class="rp__meta mono">{boxLine(recap.box)} · {countsLine(recap.entry)}</p>
      </div>
      <img class="rp__mug" src={headshot} srcset={headshotSrcSet(headshot, [180, 420])} sizes="96px" alt="" width="96" height="96" decoding="async" />
    </header>

    <section class="rp__section" aria-labelledby="periods-h">
      <h2 id="periods-h">The room, by quarter</h2>
      <PeriodStrip cells={recap.cells} size="hero" subject={name} />
    </section>

    <section class="rp__section" aria-labelledby="replay-h">
      <h2 id="replay-h">The replay</h2>
      <RecapReplay
        client:load
        recapKey={recap.key}
        name={name}
        away={{ abbr: recap.line.away.abbr, name: recap.awayTeam.name }}
        home={{ abbr: recap.line.home.abbr, name: recap.homeTeam.name, logo: recap.homeTeam.logo }}
        his={recap.his}
        cells={recap.cells}
        usual={recap.usual}
        lagSeconds={lagSeconds}
        flairAbbr={flairAbbr}
        official={manifest.rules.qualified_threshold}
        tint={CROWD_TINT}
      />
    </section>

    <section class="rp__section" aria-labelledby="night-h">
      <h2 id="night-h">The night against his usual</h2>
      <div class="rp__verdict">
        <VerdictDelta delta={recap.delta} n={recap.night?.total ?? 0} />
        <p class="rp__verdict-text">{verdict}</p>
      </div>
    </section>

    {
      points.length >= SCATTER_MIN && (
        <section class="rp__section" aria-labelledby="scatter-h">
          <h2 id="scatter-h">Where the night sits among his games</h2>
          <GameScatter points={points} baseline={negRate(recap.usual)} lead={scatterLead(name, points.length, r)} r={r} highlight={recap.game.game_id} />
        </section>
      )
    }

    <MethodNote kind="method">
      The replay and the quarters count his comments in the game's live thread, each on the clock by its own timestamp{lag ? `, and the room takes ${lag} to react to a play` : ''}.
      The verdict counts every thread about him that night, post-game included, against his season: a different population.
    </MethodNote>

    <p class="rp__links mono">
      <a href={`/player/${recap.player.slug}/`}>{name}'s season page →</a>
      {next && (
        <a href={recapHref(next.key)}>
          Next recap: {next.entry.attributed_player}, {gamePhrase(next.line)} →
        </a>
      )}
      <a href="/recaps/">All recaps</a>
    </p>
  </main>
</Base>

<style>
  .rp {
    gap: 40px;
  }
  .rp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    gap: 16px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .rp__head-text {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .rp__up {
    color: var(--mute);
  }
  .rp__name {
    margin: 0;
  }
  .rp__name--neg {
    color: var(--heat);
  }
  .rp__name--pos {
    color: var(--ice);
  }
  .rp__hook {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.3;
    text-wrap: balance;
  }
  .rp__meta {
    margin: 0;
    font-size: 13px;
    color: var(--bone-2);
  }
  .rp__mug {
    width: 96px;
    height: 96px;
    border-radius: 3px;
    border: 1px solid var(--line);
    object-fit: cover;
    object-position: top;
    background: var(--surface-2);
    filter: grayscale(0.85) contrast(1.05);
  }
  .rp__section {
    display: grid;
    gap: 16px;
  }
  .rp__section h2 {
    margin: 0;
  }
  .rp__verdict {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .rp__verdict-text {
    max-width: 60ch;
    margin: 0;
    color: var(--bone-2);
  }
  .rp__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    font-size: 13px;
  }
  .rp__links a {
    color: var(--bone-2);
  }
</style>
