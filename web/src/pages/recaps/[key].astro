---
// One recap's page. The header, the sections after the buzzer and the
// method are HTML at build; the stage is the replay island, which fetches
// the recap file on hydration and receives its joins as props.
import type { InferGetStaticPropsType } from 'astro'

import { cardHref } from '../../cards/model'
import { GameLine } from '../../components/GameLine'
import { GameNetTimeline } from '../../components/GameNetTimeline'
import { MethodNote } from '../../components/MethodNote'
import { PeriodStrip } from '../../components/PeriodStrip'
import { RecapReplay } from '../../components/replay/RecapReplay'
import { SentimentBar } from '../../components/SentimentBar'
import { VerdictDelta } from '../../components/VerdictDelta'
import { getSeason } from '../../data'
import Base from '../../layouts/Base.astro'
import { fmtInt } from '../../lib/format'
import { buildGameLog } from '../../lib/games'
import { headshotSrcSet } from '../../lib/media'
import { netSentiment } from '../../lib/metrics'
import { fmtNet, netOf, netStyle } from '../../lib/net'
import { boxLine, buildRecaps, countsLine, gamePhrase, lagPhrase, nextRecap, nightNetSentence, nightPoints, nightRankSentence, quarterTurnSentence, recapHref, recapHrefs, recapNetDelta } from '../../lib/recaps'
import { REPLAY_KEYS } from '../../lib/url'

export async function getStaticPaths() {
  const { manifest, tables } = await getSeason()
  const recaps = buildRecaps(manifest, tables)
  return recaps.map((recap) => ({ params: { key: recap.key }, props: { recap, next: nextRecap(recaps, recap.key) } }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { recap, next } = Astro.props
const { manifest, tables } = await getSeason()
const name = recap.entry.attributed_player
const teamByAbbr = new Map(tables.teams.map((t) => [t.abbreviation, t]))
const side = (abbr: string) => {
  const t = teamByAbbr.get(abbr)
  return { abbr, name: t?.team ?? abbr, logo: t?.logo_url ?? '' }
}
const names = Object.fromEntries(tables.players.map((p) => [String(p.player_id), p.attributed_player]))
const abbrOf = Object.fromEntries(tables.teams.map((t) => [t.team, t.abbreviation]))
const headshot = recap.player.headshot_url
const floor = manifest.rules.floors.game_min_n
const lag = lagPhrase(manifest.rules.recaps.reaction_lag.median_offset_seconds)
const title = `${name} · ${recap.line.game ?? recap.line.date}`
// After the buzzer, in net: the night against his season, the room by quarter, the season his night sits in.
const verdict = nightNetSentence(name, recap.night, recap.usual, floor)
const netDelta = recapNetDelta(recap.night, recap.usual, floor)
const quarters = quarterTurnSentence(recap.cells)
const abbrMap = new Map(tables.teams.map((t) => [t.team, t.abbreviation]))
const gamesById = new Map(tables.games.map((g) => [g.game_id, g]))
const log = buildGameLog(
  tables.player_games.filter((r) => r.attributed_player === name),
  tables.game_sentiment.filter((r) => r.attributed_player === name),
  gamesById,
  abbrMap,
  recap.usual,
  floor,
  recapHrefs(manifest.recaps, name),
)
const nights = nightPoints(log)
const nightsLead = nightRankSentence(nights, recap.entry.game_id, recap.usual)
const nightLabel = recap.line.game ? `${recap.line.round.replace('NBA Finals', 'Finals').replace('Conf. semifinals', 'Semis')} ${recap.line.game.replace('Game ', 'G')}` : recap.line.date
const seasonNet = netSentiment(recap.usual)
---

<Base title={title} description={recap.hook} image={cardHref.recap(recap.key)}>
  <script is:inline define:vars={{ replay: REPLAY_KEYS }}>
    // A deep link names a moment: hold the stage's prerendered default out
    // of sight until the island has read the URL (it removes the class).
    const q = new URLSearchParams(location.search)
    if (replay.some((k) => q.has(k))) document.documentElement.classList.add('has-replay-view')
  </script>
  <main id="main" class="wrap page rp">
    <header class="rp__head">
      <p class="eyebrow rp__eyebrow"><a class="rp__up" href="/recaps/">Recaps</a> · <GameLine parts={recap.line} /></p>
      <h1 class={`rp__name rp__name--${recap.tone}`}>{name}</h1>
      <img class="rp__mug" src={headshot} srcset={headshotSrcSet(headshot, [180, 420])} sizes="96px" alt="" width="96" height="96" decoding="async" />
      <p class="rp__hook">{recap.hook}</p>
      <p class="rp__meta mono">{boxLine(recap.box)} · {countsLine(recap.entry)}</p>
    </header>

    <section class="rp__stage" aria-label="The replay">
      <RecapReplay client:load recapKey={recap.key} name={name} focusId={recap.player.player_id} away={side(recap.line.away.abbr)} home={side(recap.line.home.abbr)} usual={recap.usual} names={names} abbrOf={abbrOf} official={manifest.rules.qualified_threshold} />
    </section>

    <section class="rp__section" aria-labelledby="night-h">
      <h2 id="night-h">The night against his season</h2>
      <p class="rp__lede">{verdict}</p>
      <VerdictDelta delta={netDelta} n={recap.night?.total ?? 0} metric="net" span={0.6} size="hero" tickLabel={`his season (${fmtNet(seasonNet)})`} />
      <dl class="rp__mix mono">
        <dt>This night</dt>
        <dd>
          <b style={netStyle(recap.night ? netOf(recap.night) : null)}>{fmtNet(recap.night ? netOf(recap.night) : null)}</b>
          {recap.night && <SentimentBar counts={recap.night} size="mini" subject="This night" />}
          <span>{recap.night ? `${fmtInt(recap.night.total)} comments` : 'no comments'}</span>
        </dd>
        <dt>His season</dt>
        <dd>
          <b style={netStyle(seasonNet)}>{fmtNet(seasonNet)}</b>
          <SentimentBar counts={recap.usual} size="mini" subject="His season" />
          <span>{fmtInt(recap.usual.total)} comments</span>
        </dd>
      </dl>
    </section>

    <section class="rp__section" aria-labelledby="quarters-h">
      <h2 id="quarters-h">The room by quarter</h2>
      <p class="rp__lede">{quarters}</p>
      <PeriodStrip cells={recap.cells} size="hero" subject={name} figure="net" />
    </section>

    <section class="rp__section" aria-labelledby="nights-h">
      <h2 id="nights-h">Where the night sits among his games</h2>
      <GameNetTimeline points={nights} baseline={seasonNet} highlight={recap.entry.game_id} highlightLabel={nightLabel} lead={nightsLead} />
      <p class="rp__floor mono">games with at least {fmtInt(floor)} comments about him</p>
    </section>

    <MethodNote kind="method">
      Net sentiment is the positive share minus the negative share, in points: +100 is every comment positive, −100 every comment negative. The replay, the gauge and the quarters count
      his comments in the game's live thread, the primary and any split, each on the game clock by its own timestamp{lag ? `; the room takes ${lag} to react to a play` : ''}. The
      night counts every thread about him that night, post-game included, against his season: a different population.
    </MethodNote>

    <p class="rp__links mono">
      <a href={`/player/${recap.player.slug}/`}>{name}'s season page →</a>
      {next && <a href={recapHref(next.key)}>Next recap: {next.entry.attributed_player}, {gamePhrase(next.line)} →</a>}
      <a href="/recaps/">All recaps</a>
    </p>
  </main>
</Base>

<style>
  .rp {
    gap: 40px;
  }
  /* The headshot sits on the name's row, centred on it. */
  .rp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    grid-template-areas:
      'eyebrow eyebrow'
      'name mug'
      'hook hook'
      'meta meta';
    gap: 12px 16px;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .rp__eyebrow {
    grid-area: eyebrow;
    margin: 0;
  }
  .rp__up {
    color: var(--mute);
  }
  .rp__name {
    grid-area: name;
    margin: 0;
    min-width: 0;
  }
  .rp__hook {
    grid-area: hook;
  }
  .rp__meta {
    grid-area: meta;
  }
  .rp__name--neg {
    color: var(--heat);
  }
  .rp__name--pos {
    color: var(--ice);
  }
  .rp__hook {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.3;
    text-wrap: balance;
  }
  .rp__meta {
    margin: 0;
    font-size: 13px;
    color: var(--bone-2);
  }
  .rp__mug {
    grid-area: mug;
    width: 96px;
    height: 96px;
    border-radius: 3px;
    border: 1px solid var(--line);
    object-fit: cover;
    object-position: top;
    background: var(--surface-2);
    filter: grayscale(0.85) contrast(1.05);
  }
  .rp__section {
    display: grid;
    gap: 16px;
  }
  .rp__section h2 {
    margin: 0;
  }
  .rp__stage {
    padding-bottom: 8px;
  }
  .rp__lede {
    max-width: 62ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
    color: var(--bone-2);
  }
  .rp__mix {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    align-items: center;
    max-width: 760px;
    margin: 0;
    font-size: 12px;
    color: var(--bone-2);
  }
  .rp__mix dd {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) max-content;
    gap: 12px;
    align-items: center;
    margin: 0;
  }
  .rp__mix b {
    font-family: var(--display);
    font-size: 24px;
    line-height: 1;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .rp__mix span {
    color: var(--mute);
  }
  .rp__floor {
    margin: 0;
    font-size: 12px;
    color: var(--mute);
  }
  .rp__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    font-size: 13px;
  }
  .rp__links a {
    color: var(--bone-2);
  }
</style>
