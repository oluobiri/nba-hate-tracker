---
// One recap's page. The header, the sections after the buzzer and the
// method are HTML at build; the stage is the replay island, which fetches
// the recap file on hydration and receives its joins as props.
import type { InferGetStaticPropsType } from 'astro'

import { cardHref } from '../../cards/model'
import { GameLine } from '../../components/GameLine'
import { MethodNote } from '../../components/MethodNote'
import { RecapReplay } from '../../components/replay/RecapReplay'
import { VerdictDelta } from '../../components/VerdictDelta'
import { getSeason } from '../../data'
import Base from '../../layouts/Base.astro'
import { headshotSrcSet } from '../../lib/media'
import { boxLine, buildRecaps, countsLine, lagPhrase, nightSentence } from '../../lib/recaps'
import { REPLAY_KEYS } from '../../lib/url'

export async function getStaticPaths() {
  const { manifest, tables } = await getSeason()
  return buildRecaps(manifest, tables).map((recap) => ({ params: { key: recap.key }, props: { recap } }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { recap } = Astro.props
const { manifest, tables } = await getSeason()
const name = recap.entry.attributed_player
const teamByAbbr = new Map(tables.teams.map((t) => [t.abbreviation, t]))
const side = (abbr: string) => {
  const t = teamByAbbr.get(abbr)
  return { abbr, name: t?.team ?? abbr, logo: t?.logo_url ?? '' }
}
const names = Object.fromEntries(tables.players.map((p) => [String(p.player_id), p.attributed_player]))
const abbrOf = Object.fromEntries(tables.teams.map((t) => [t.team, t.abbreviation]))
const headshot = recap.player.headshot_url
const floor = manifest.rules.floors.game_min_n
const lag = lagPhrase(manifest.rules.recaps.reaction_lag.median_offset_seconds)
const title = `${name} · ${recap.line.game ?? recap.line.date}`
const verdict = nightSentence(name, recap.night, recap.usual, floor)
---

<Base title={title} description={recap.hook} image={cardHref.recap(recap.key)}>
  <script is:inline define:vars={{ replay: REPLAY_KEYS }}>
    // A deep link names a moment: hold the stage's prerendered default out
    // of sight until the island has read the URL (it removes the class).
    const q = new URLSearchParams(location.search)
    if (replay.some((k) => q.has(k))) document.documentElement.classList.add('has-replay-view')
  </script>
  <main id="main" class="wrap page rp">
    <header class="rp__head">
      <div class="rp__head-text">
        <p class="eyebrow"><a class="rp__up" href="/recaps/">Recaps</a> · <GameLine parts={recap.line} /></p>
        <h1 class={`rp__name rp__name--${recap.tone}`}>{name}</h1>
        <p class="rp__hook">{recap.hook}</p>
        <p class="rp__meta mono">{boxLine(recap.box)} · {countsLine(recap.entry)}</p>
      </div>
      <img class="rp__mug" src={headshot} srcset={headshotSrcSet(headshot, [180, 420])} sizes="96px" alt="" width="96" height="96" decoding="async" />
    </header>

    <section class="rp__stage" aria-label="The replay">
      <RecapReplay client:load recapKey={recap.key} name={name} focusId={recap.player.player_id} away={side(recap.line.away.abbr)} home={side(recap.line.home.abbr)} usual={recap.usual} names={names} abbrOf={abbrOf} official={manifest.rules.qualified_threshold} />
    </section>

    <section class="rp__section" aria-labelledby="night-h">
      <h2 id="night-h">The night against his usual</h2>
      <div class="rp__verdict">
        <VerdictDelta delta={recap.delta} n={recap.night?.total ?? 0} />
        <p class="rp__verdict-text">{verdict}</p>
      </div>
    </section>

    <MethodNote kind="method">
      The quarters count his comments in the game's live thread, the primary and any split; the verdict counts every thread about him that night, post-game included, against his
      season, so the two are different populations. Each comment sits on the game clock by its own timestamp{lag ? `; the room takes ${lag} to react to a play` : ''}.
    </MethodNote>

    <p class="rp__links mono">
      <a href={`/player/${recap.player.slug}/`}>{name}'s season page →</a>
      <a href="/recaps/">All recaps</a>
    </p>
  </main>
</Base>

<style>
  .rp {
    gap: 40px;
  }
  .rp__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    gap: 16px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .rp__head-text {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .rp__up {
    color: var(--mute);
  }
  .rp__name {
    margin: 0;
  }
  .rp__name--neg {
    color: var(--heat);
  }
  .rp__name--pos {
    color: var(--ice);
  }
  .rp__hook {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.3;
    text-wrap: balance;
  }
  .rp__meta {
    margin: 0;
    font-size: 13px;
    color: var(--bone-2);
  }
  .rp__mug {
    width: 96px;
    height: 96px;
    border-radius: 3px;
    border: 1px solid var(--line);
    object-fit: cover;
    object-position: top;
    background: var(--surface-2);
    filter: grayscale(0.85) contrast(1.05);
  }
  .rp__section {
    display: grid;
    gap: 16px;
  }
  .rp__section h2 {
    margin: 0;
  }
  .rp__stage {
    padding-bottom: 8px;
  }
  .rp__verdict {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .rp__verdict-text {
    max-width: 60ch;
    margin: 0;
    color: var(--bone-2);
  }
  .rp__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    font-size: 13px;
  }
  .rp__links a {
    color: var(--bone-2);
  }
</style>
