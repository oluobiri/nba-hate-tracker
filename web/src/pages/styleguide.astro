---
import { BoardRow } from '../components/BoardRow'
import { DeltaDot } from '../components/DeltaDot'
import { Exhibit, commentUrl } from '../components/Exhibit'
import { Games } from '../components/Games'
import { GameScatter } from '../components/GameScatter'
import { GamesTable } from '../components/GamesTable'
import { GapTable } from '../components/GapTable'
import { LensTabs } from '../components/LensTabs'
import { MethodNote } from '../components/MethodNote'
import { RankNumeral } from '../components/RankNumeral'
import { Receipts, type ReceiptItem } from '../components/Receipts'
import SectionRail from '../components/SectionRail.astro'
import { SentimentBar } from '../components/SentimentBar'
import { Stamp } from '../components/Stamp'
import { StatFigure } from '../components/StatFigure'
import { TalkList } from '../components/TalkList'
import { ThresholdControl } from '../components/ThresholdControl'
import { Timeline, type TimelineWeek } from '../components/Timeline'
import { VerdictDelta } from '../components/VerdictDelta'
import { WeekAxis, WeeklyTitles, type TitleRow } from '../components/WeeklyTitles'
import { getSeason } from '../data'
import Base from '../layouts/Base.astro'
import { deltaLists, gapRows, playerCells, playerUsual, talkRows } from '../lib/fanbase'
import { nickname, possessive } from '../lib/fans'
import { headshotVariant } from '../lib/media'
import { fmtInt, fmtPct, fmtSigned } from '../lib/format'
import { groupBy } from '../lib/group'
import { commentDate, receiptContext } from '../lib/receipts'
import { buildGameLog, scatterLead, scatterPoints, weekGames } from '../lib/games'
import { countsOf, negRate, pearson, posRate, rankBy, rollingRate, sumCounts } from '../lib/metrics'
import { extremeWeeks, phaseBands, spineRows, timelineSummary, weekSpine } from '../lib/weeks'
import { thresholdStops } from '../lib/threshold'
import { weeklyHolders } from '../lib/titles'
import type { Sentiment } from '../lib/types'

// Every variant on real data, the awkward cases chosen by rule so the page
// keeps showing them as the data moves.
const { manifest, tables } = await getSeason()
const threshold = manifest.rules.qualified_threshold

const overall = tables.player_overall.map((r) => ({ ...r, ...countsOf(r) }))
const qualified = overall.filter((r) => r.total >= threshold)
const byNeg = rankBy(overall, 'neg', threshold)
const top = byNeg.find((r) => r.rank === 1)!.row
const leastPositive = qualified.toSorted((a, b) => posRate(a) - posRate(b))[0]!
const unofficial = byNeg.find((r) => r.rank === null)!.row
const byVolume = rankBy(overall, 'volume', threshold).slice(0, 5)
const maxVolume = byVolume[0]!.value

const players = new Map(tables.players.map((p) => [p.attributed_player, p]))
const abbrOf = new Map(tables.teams.map((t) => [t.team, t.abbreviation]))
const noRoster = tables.players.find((p) => p.roster_team === null)!
const posts = new Map(tables.posts.map((p) => [p.post_id, p]))
const gamesById = new Map(tables.games.map((g) => [g.game_id, g]))
const exhibitProps = (r: (typeof tables.comment_samples)[number]) => {
  const post = posts.get(r.link_id)
  return {
    body: r.body,
    sentiment: r.sentiment as Sentiment,
    score: r.score,
    sourceUrl: commentUrl(r.link_id, r.comment_id),
    context: receiptContext(post, post?.game_id ? gamesById.get(post.game_id) : undefined, abbrOf),
    flair: r.fan_team ? (abbrOf.get(r.fan_team) ?? null) : null,
    date: commentDate(r.created_utc),
  }
}
const receipt = tables.comment_samples.find((r) => r.sentiment === 'neg' && posts.has(r.link_id) && r.body.length < 240)!
const orphan = tables.comment_samples.find((r) => !posts.has(r.link_id))
const neutral = tables.comment_samples.find((r) => r.sentiment === 'neu' && posts.has(r.link_id) && r.body.length < 240)!

const sizes = ['hero', 'row', 'mini'] as const
const maxN = Math.max(...overall.map((r) => r.total))
const stops = thresholdStops(manifest.rules.floors.fanbase_min_n, maxN, threshold)
const customN = stops.find((s) => s < threshold) ?? threshold
const customRanked = overall.filter((r) => r.total >= customN).length
const rowProps = (name: string) => {
  const p = players.get(name)!
  return { name, slug: p.slug, abbr: p.roster_team ? (abbrOf.get(p.roster_team) ?? null) : null, position: p.position, headshot: p.headshot_url }
}
const freeAgent = byNeg.find((r) => r.rank !== null && players.get(r.row.attributed_player)?.roster_team === null)
const byCustom = rankBy(overall, 'neg', customN)
const hollow = byCustom.find((r) => r.rank !== null && r.row.total < threshold)!
const ghost = byCustom.find((r) => r.rank === null)!
const temporal: TitleRow[] = tables.player_temporal.map((r) => {
  const p = players.get(r.attributed_player)!
  return { ...countsOf(r), week: r.week, name: r.attributed_player, slug: p.slug, headshot: p.headshot_url }
})
const weeks = [...new Set(temporal.map((r) => r.week))].toSorted()
const belt = weeklyHolders(temporal, 'neg', manifest.rules.floors.belt_min_n)
const flowers = weeklyHolders(temporal, 'pos', manifest.rules.floors.belt_min_n)
const strongest = belt.toSorted((a, b) => b.rate - a.rate)[0]!
const weakest = flowers.toSorted((a, b) => a.rate - b.rate)[0]!
const fans = tables.fan_team_overall.map((r) => ({ ...r, ...countsOf(r) })).toSorted((a, b) => negRate(b) - negRate(a))
const leagueNeg = negRate(sumCounts(fans))
const fanRows = fans.slice(0, 8).map((r) => ({ key: r.abbreviation, label: `${r.abbreviation} fans`, href: `/fanbases/${r.abbreviation.toLowerCase()}/`, value: negRate(r), n: r.total, logo: r.logo_url }))
const fanDomain = [Math.min(...fans.map(negRate)), Math.max(...fans.map(negRate))] as const
const taggedRows = fanRows.slice(0, 5).map((r, i) => (i === 2 ? { ...r, tag: 'own fans' } : r))

// The game log of #1 by negative rate: the verdict cases and the table's rows.
const gameFloor = manifest.rules.floors.game_min_n
const topLog = buildGameLog(
  tables.player_games.filter((r) => r.attributed_player === top.attributed_player),
  tables.game_sentiment.filter((r) => r.attributed_player === top.attributed_player),
  gamesById,
  abbrOf,
  top,
  gameFloor,
)
const judged = topLog.filter((g) => g.delta !== null)
const harshest = judged.toSorted((a, b) => b.delta! - a.delta!)[0]
const kindest = judged.toSorted((a, b) => a.delta! - b.delta!)[0]
const quiet = topLog.find((g) => !g.talked)
const topPoints = scatterPoints(topLog)
const topR = pearson(topPoints.map((p) => p.x), topPoints.map((p) => p.y))
// Ten rows for the table: talked games plus a DNP line and a neutral-site game when he has them.
const tableRows = [...new Set([...topLog.filter((g) => g.talked).slice(0, 8), topLog.find((g) => g.dnp), topLog.find((g) => g.home === null), quiet].filter((g) => g !== undefined))]
  .toSorted((a, b) => b.date.localeCompare(a.date))

// Timelines: the full case, the thinnest official one, and the one with the fewest weeks at all.
const weekFloor = manifest.rules.floors.week_min_n
const ROLLING = 4
const spine = weekSpine(tables.player_temporal.map((r) => r.week))
const bands = phaseBands(spine, manifest.calendar)
const temporalBy = new Map<string, typeof tables.player_temporal>()
for (const r of tables.player_temporal) temporalBy.set(r.attributed_player, [...(temporalBy.get(r.attributed_player) ?? []), r])
const timelineFor = (name: string, log = topLog) => {
  const rows = spineRows(spine, (temporalBy.get(name) ?? []).map((r) => ({ ...countsOf(r), week: r.week })))
  const counts = rows.map((r) => (r ? { neg: r.neg, neu: r.neu, pos: r.pos, total: r.total } : null))
  const negLine = rollingRate(counts, ROLLING, negRate, weekFloor)
  const posLine = rollingRate(counts, ROLLING, posRate, weekFloor)
  const games = weekGames(log, spine).map((ws) => ws.map((g) => `${g.win ? 'W' : 'L'} ${g.home === false ? '@' : 'vs'} ${g.opponentAbbr} ${g.score}`))
  const tlWeeks: TimelineWeek[] = spine.map((key, i) => ({ key, counts: counts[i]!, games: games[i]! }))
  return { weeks: tlWeeks, negLine, posLine, marks: extremeWeeks(counts, weekFloor), summary: timelineSummary(name, spine, counts, negLine, weekFloor, ROLLING) }
}
const weeksAtFloor = (name: string) => (temporalBy.get(name) ?? []).filter((r) => r.comment_count >= weekFloor).length
const thinnestOfficial = qualified.toSorted((a, b) => weeksAtFloor(a.attributed_player) - weeksAtFloor(b.attributed_player))[0]!
const fewestWeeks = overall.toSorted((a, b) => weeksAtFloor(a.attributed_player) - weeksAtFloor(b.attributed_player))[0]!
const tlTop = timelineFor(top.attributed_player)
const tlThin = timelineFor(thinnestOfficial.attributed_player, [])
const tlNone = timelineFor(fewestWeeks.attributed_player, [])

// Receipts: the official player with the thinnest cell, so the tabs show a full cell and a thin one.
const RECEIPTS_TOP = 3
const cellsFor = (name: string): Record<Sentiment, ReceiptItem[]> => {
  const mine = tables.comment_samples.filter((r) => r.attributed_player === name).toSorted((a, b) => a.rank - b.rank)
  const cell = (s: Sentiment) => mine.filter((r) => r.sentiment === s).map((r) => { const { sentiment: _s, ...rest } = exhibitProps(r); return rest })
  return { neg: cell('neg'), neu: cell('neu'), pos: cell('pos') }
}
const thinnestCell = (name: string) => Math.min(...Object.values(cellsFor(name)).map((c) => c.length))
const thinReceipts = qualified.toSorted((a, b) => thinnestCell(a.attributed_player) - thinnestCell(b.attributed_player))[0]!
const LOG_TOP = 10

// The team page's table and Δ axis: the largest and smallest tracked rosters, and the saltiest fanbase's grudges around zero.
const fanFloor = manifest.rules.floors.fanbase_min_n
const rosterOf = new Map(tables.players.map((p) => [p.attributed_player, p.roster_team]))
const fanPlayerRows = tables.player_fan_team.map((r) => ({ ...countsOf(r), fan: r.fan_team, player: r.attributed_player, roster: rosterOf.get(r.attributed_player) ?? null }))
const fanByPlayer = groupBy(fanPlayerRows, (r) => r.player)
const rosters = [...groupBy(tables.players.filter((p) => p.roster_team !== null), (p) => p.roster_team!)].toSorted((a, b) => b[1].length - a[1].length)
const [bigTeam, bigRoster] = rosters[0]!
const [smallTeam, smallRoster] = rosters.at(-1)!
const bigGap = gapRows(bigTeam, bigRoster, fanByPlayer, fanFloor)
const smallGap = gapRows(smallTeam, smallRoster, fanByPlayer, fanFloor)
const usual = playerUsual(fanPlayerRows)
const saltiest = fans[0]!
const grudges = deltaLists(playerCells(fanPlayerRows, saltiest.fan_team), (player) => usual.get(player)!, fanFloor, (player) => {
  const p = players.get(player)!
  return { label: player, href: `/player/${p.slug}/`, logo: headshotVariant(p.headshot_url, 180) }
})
const GRUDGE_TOP = 5
const grudgeRows = grudges.grudges.slice(0, GRUDGE_TOP).map((r) => ({ key: r.key, label: r.label, href: r.href, value: r.delta, n: r.n, logo: r.logo, detail: fmtPct(r.rate, 0) }))
const pts = (v: number) => fmtSigned(v, 0)
const TALK_TOP = 10
const talk = talkRows(fanPlayerRows, saltiest.fan_team, (player) => {
  const p = players.get(player)!
  return { slug: p.slug, headshot: p.headshot_url, abbr: p.roster_team ? (abbrOf.get(p.roster_team) ?? null) : null }
}, TALK_TOP)
---

<Base title="Style guide" description="Every core component in every variant, on real data.">
  <main class="wrap guide">
    <header class="guide__head">
      <p class="eyebrow">Style guide · {manifest.season} · schema v{manifest.schema_version}</p>
      <h1>Components</h1>
      <p>
        Each component once, every variant, on the published drop. A colour, size or component change is made here
        and every page inherits it.
      </p>
    </header>

    <section class="guide__section">
      <h2>SentimentBar</h2>
      <p class="eyebrow">Negative → neutral → positive, always. Ink labels, 2 px ink gaps. Full length, 0–100.</p>
      {
        sizes.map((size) => (
          <figure class="guide__fig">
            <SentimentBar counts={top} size={size} subject={top.attributed_player} />
            <figcaption>
              size={size} · {top.attributed_player}, n={fmtInt(top.total)}
            </figcaption>
          </figure>
        ))
      }
      <figure class="guide__fig">
        <SentimentBar counts={leastPositive} size="hero" subject={leastPositive.attributed_player} />
        <figcaption>
          narrow segment: {leastPositive.attributed_player} is {fmtPct(posRate(leastPositive))} positive, the smallest
          share among qualified players, so its label moves under the bar
        </figcaption>
      </figure>
      <figure class="guide__fig">
        <SentimentBar counts={leastPositive} size="row" subject={leastPositive.attributed_player} />
        <figcaption>the same row-size</figcaption>
      </figure>
      <p class="eyebrow">Relative length: total against #1 by volume, segmented by sentiment.</p>
      {
        byVolume.map((r) => (
          <figure class="guide__fig">
            <SentimentBar counts={r.row} size="row" length="relative" scale={r.value / maxVolume} subject={r.row.attributed_player} />
            <figcaption>
              #{r.rank} {r.row.attributed_player} · n={fmtInt(r.row.total)}
            </figcaption>
          </figure>
        ))
      }
    </section>

    <section class="guide__section">
      <h2>RankNumeral</h2>
      <p class="eyebrow">Official is solid; below the official minimum it is hollow, so a crop still reads.</p>
      <div class="guide__row">
        <figure class="guide__fig"><RankNumeral rank={1} official size="lg" /><figcaption>official · lg</figcaption></figure>
        <figure class="guide__fig"><RankNumeral rank={1} official={false} size="lg" /><figcaption>hollow · lg</figcaption></figure>
        <figure class="guide__fig"><RankNumeral rank={17} official /><figcaption>official · md</figcaption></figure>
        <figure class="guide__fig"><RankNumeral rank={17} official={false} /><figcaption>hollow · md</figcaption></figure>
      </div>
      <figure class="guide__fig guide__fig--row">
        <RankNumeral rank={byNeg.length} official={false} />
        <span>{unofficial.attributed_player}</span>
        <SentimentBar counts={unofficial} size="row" subject={unofficial.attributed_player} />
        <span class="mono">n={fmtInt(unofficial.total)}</span>
        <figcaption>an unofficial row: below the official minimum of {fmtInt(threshold)} comments</figcaption>
      </figure>
    </section>

    <section class="guide__section">
      <h2>MethodNote</h2>
      <p class="eyebrow">The one place yellow appears.</p>
      <div class="guide__stack">
        <MethodNote kind="read-first">
          A rate, not a count. #1 {top.attributed_player} is on n={fmtInt(top.total)}. Read n before you post the
          screenshot.
        </MethodNote>
        <MethodNote kind="rule">
          Official rankings need at least {fmtInt(threshold)} comments; {qualified.length} of {overall.length} players
          qualify.
        </MethodNote>
        <MethodNote kind="caveat">Sentiment is not hate. A negative comment can be criticism of one game.</MethodNote>
        <MethodNote kind="method">
          Negative rate = {manifest.rules.metrics.neg_rate}. Rates are re-derived from counts, never averaged.
        </MethodNote>
      </div>
    </section>

    <section class="guide__section">
      <h2>Stamp</h2>
      <div class="guide__row"><Stamp kind="verified" /><Stamp kind="unofficial" /></div>
    </section>

    <section class="guide__section">
      <h2>Exhibit</h2>
      <p class="eyebrow">A receipt: the sentiment as its edge, the commenter's flair, verbatim body, the thread as one line, score, date, source. No username, ever.</p>
      <div class="guide__stack">
        <Exhibit number={1} {...exhibitProps(receipt)} stamp={manifest.rules.receipts.verified ? 'verified' : undefined} />
        <Exhibit number={2} {...exhibitProps(neutral)} />
        {orphan && <Exhibit number={3} {...exhibitProps(orphan)} stamp={manifest.rules.receipts.verified ? 'verified' : undefined} />}
      </div>
      <p class="eyebrow">Neutral receipts never carry a stamp. The third has no post in the bridge.</p>
    </section>

    <section class="guide__section">
      <h2>LensTabs</h2>
      <p class="eyebrow">Underline heat / ice / bone / split. Arrow keys move; the subtitle names the metric.</p>
      <div class="guide__stack">
        <LensTabs lens="neg" onChange={() => {}} id="guide-neg" />
        <LensTabs lens="polar" onChange={() => {}} id="guide-polar" />
      </div>
    </section>

    <section class="guide__section">
      <h2>BoardRow</h2>
      <p class="eyebrow">The whole row is the link. Rank, mug, who, bar, value, n; chip for unofficial and for rank movement.</p>
      <ol class="guide__rows">
        <BoardRow rank={1} official {...rowProps(top.attributed_player)} counts={top} lens="neg" />
        {freeAgent && <BoardRow rank={freeAgent.rank} official {...rowProps(freeAgent.row.attributed_player)} counts={freeAgent.row} lens="neg" delta={2} />}
        <BoardRow rank={hollow.rank} official={false} {...rowProps(hollow.row.attributed_player)} counts={hollow.row} lens="neg" />
        <BoardRow rank={null} official={false} {...rowProps(ghost.row.attributed_player)} counts={ghost.row} lens="neg" />
        {byVolume.slice(0, 2).map((r) => <BoardRow rank={r.rank} official {...rowProps(r.row.attributed_player)} counts={r.row} lens="volume" scale={r.value / maxVolume} />)}
      </ol>
      <p class="eyebrow">Official · free agent with a rank-delta chip · hollow (below the official minimum) · ghosted (below the custom threshold) · volume lens.</p>
    </section>

    <section class="guide__section">
      <h2>ThresholdControl</h2>
      <p class="eyebrow">Collapsed by default; open on tap; open, loud and stamped once moved. Reset returns to the manifest value.</p>
      <div class="guide__stack">
        <ThresholdControl value={threshold} official={threshold} stops={stops} ranked={qualified.length} total={overall.length} onChange={() => {}} />
        <ThresholdControl value={threshold} official={threshold} stops={stops} ranked={qualified.length} total={overall.length} onChange={() => {}} defaultOpen />
        <ThresholdControl value={customN} official={threshold} stops={stops} ranked={customRanked} total={overall.length} onChange={() => {}} />
      </div>
    </section>

    <section class="guide__section">
      <h2>StatFigure</h2>
      <div class="guide__row guide__row--stats">
        <StatFigure figure={fmtPct(negRate(top))} label="Negative" detail={`of ${fmtInt(top.total)} comments`} tone="neg" />
        <StatFigure figure={fmtPct(posRate(top))} label="Positive" tone="pos" />
        <StatFigure figure={fmtInt(top.total)} label="Comments" detail="attributed to one player" />
        <StatFigure figure={String(qualified.length)} label="Ranked" detail={`of ${overall.length} tracked`} />
      </div>
    </section>

    <section class="guide__section">
      <h2>WeeklyTitles</h2>
      <p class="eyebrow">
        Belt above, Flowers below, one axis, one scroller. Intensity follows the rate: {strongest.row.name}'s{' '}
        {fmtPct(strongest.rate)} week is the strongest Belt win; {weakest.row.name}'s {fmtPct(weakest.rate)} the weakest Flowers win.
      </p>
      <div class="wk-scroller">
        <WeeklyTitles metric="neg" weeks={weeks} holders={belt} label="The Belt" />
        <WeekAxis weeks={weeks} />
        <WeeklyTitles metric="pos" weeks={weeks} holders={flowers} label="The Flowers" />
      </div>
      <p class="eyebrow">Prototype: reign blocks, consecutive weeks by one holder merged.</p>
      <div class="wk-scroller">
        <WeeklyTitles metric="neg" weeks={weeks} holders={belt} label="The Belt" merge />
        <WeekAxis weeks={weeks} />
        <WeeklyTitles metric="pos" weeks={weeks} holders={flowers} label="The Flowers" merge />
      </div>
    </section>

    <section class="guide__section">
      <h2>DeltaDot</h2>
      <p class="eyebrow">Dots on one zoomed axis; the tick is the league average from summed counts, never a mean of rates. Every row prints its value, so the axis carries only the tick's label. Ranks read down.</p>
      <DeltaDot rows={fanRows} average={leagueNeg} domain={fanDomain} format={(v) => fmtPct(v)} tone="neg" />
      <p class="eyebrow">With a Δ column and a tagged row: the player page's "who hates him most", the tick his own average.</p>
      <DeltaDot rows={taggedRows} average={leagueNeg} domain={fanDomain} format={(v) => fmtPct(v)} tone="neg" averageLabel="His average" showDelta />
    </section>

    <section class="guide__section">
      <h2>GapTable</h2>
      <p class="eyebrow">
        Own fans against every other fanbase, one row per roster player, kindest first. Ice where own fans are kinder, heat where harsher, the sign printed; a row under the floor of {fmtInt(fanFloor)} of their own comments keeps its rates in gray and no Δ. The {nickname(bigTeam)}: the largest tracked roster. {bigGap.some((r) => r.delta === null) ? 'Includes a row under the floor.' : 'Every row clears the floor this drop.'}
      </p>
      <GapTable rows={bigGap} caption={`${possessive(bigTeam)} on their own players`} floor={fanFloor} />
      <p class="eyebrow">The {nickname(smallTeam)}: the smallest tracked roster, still a table.</p>
      <GapTable rows={smallGap} caption={`${possessive(smallTeam)} on their own players`} floor={fanFloor} />
      <p class="eyebrow">DeltaDot on a Δ axis: each row against its own roster's average across every fanbase, so the tick sits at zero and says what it stands for; the value is in points, the raw rate in gray beside it, a headshot in the logo slot. {possessive(saltiest.fan_team)}' grudges, top {GRUDGE_TOP} of {grudges.eligible} players.</p>
      <DeltaDot rows={grudgeRows} average={0} domain={grudges.domain} format={pts} tone="neg" tickLabel="Each player's usual" detailLabel="rate" />
    </section>

    <section class="guide__section">
      <h2>TalkList</h2>
      <p class="eyebrow">A fanbase's most-discussed players, own roster included and tagged. Bar length is his share of the leader's n, the segments his split; n printed. {possessive(saltiest.fan_team)}, top {TALK_TOP}.</p>
      <TalkList rows={talk} fans={possessive(saltiest.fan_team)} />
    </section>

    <section class="guide__section">
      <h2>VerdictDelta</h2>
      <p class="eyebrow">A game against his usual: signed points, a bar from the baseline, n. Heat harsher, ice kinder; the sign is printed.</p>
      <div class="guide__row">
        {harshest && <figure class="guide__fig"><VerdictDelta delta={harshest.delta} n={harshest.counts!.total} /><figcaption>harshest · {harshest.opponentAbbr} {harshest.score}</figcaption></figure>}
        {kindest && <figure class="guide__fig"><VerdictDelta delta={kindest.delta} n={kindest.counts!.total} /><figcaption>kindest · {kindest.opponentAbbr} {kindest.score}</figcaption></figure>}
        <figure class="guide__fig"><VerdictDelta delta={0} n={top.total} /><figcaption>at his usual</figcaption></figure>
        {quiet && <figure class="guide__fig"><VerdictDelta delta={null} n={quiet.counts?.total ?? 0} /><figcaption>under the floor of {fmtInt(gameFloor)}</figcaption></figure>}
      </div>
    </section>

    <section class="guide__section">
      <h2>GamesTable</h2>
      <p class="eyebrow">A real table, newest first. Wins bold, losses gray. On a phone: date, opponent, result, P/R/A, verdict; nothing scrolls sideways.</p>
      <GamesTable rows={tableRows} caption={`${top.attributed_player}'s game log, a sample`} />
      <p class="eyebrow">
        {topLog.some((g) => g.dnp) ? 'Includes a DNP line. ' : 'He has no DNP line this season. '}
        {topLog.some((g) => g.home === null) ? 'Includes a neutral-site game. ' : 'He has no neutral-site game this season. '}
        {quiet ? 'Includes a game under the floor.' : ''}
      </p>
    </section>

    <section class="guide__section">
      <h2>GameScatter</h2>
      <p class="eyebrow">Game Score across, the negative share up; wins filled bone, losses hollow; his usual as a dashed rule. The table is the accessible equivalent.</p>
      <GameScatter points={topPoints} baseline={negRate(top)} lead={scatterLead(top.attributed_player, topPoints.length, topR)} r={topR} />
    </section>

    <section class="guide__section">
      <h2>Timeline</h2>
      <p class="eyebrow">
        {ROLLING}-week rolling lines from summed counts, weekly dots sized by n behind, neutral phase bands, worst and best week marked. Hover, focus or tap a week for its games.
      </p>
      <Timeline name={top.attributed_player} {...tlTop} bands={bands} floor={weekFloor} k={ROLLING} />
      <p class="eyebrow">The thinnest official timeline: {thinnestOfficial.attributed_player}, {weeksAtFloor(thinnestOfficial.attributed_player)} of {spine.length} weeks at the floor.</p>
      <Timeline name={thinnestOfficial.attributed_player} {...tlThin} bands={bands} floor={weekFloor} k={ROLLING} />
      <p class="eyebrow">Nothing to draw: {fewestWeeks.attributed_player}, {weeksAtFloor(fewestWeeks.attributed_player)} weeks at the floor.</p>
      <Timeline name={fewestWeeks.attributed_player} {...tlNone} bands={bands} floor={weekFloor} k={ROLLING} />
    </section>

    <section class="guide__section">
      <h2>Receipts</h2>
      <p class="eyebrow">
        Three tabs in sentiment order, arrow keys move; the tab and the expansion live in the URL. Verified on negative and positive only. Rendered static here, hydrated on the player page.
      </p>
      <Receipts name={thinReceipts.attributed_player} cells={cellsFor(thinReceipts.attributed_player)} verified={manifest.rules.receipts.verified} top={RECEIPTS_TOP} official={threshold} />
      <p class="eyebrow">{thinReceipts.attributed_player}: the official player with the thinnest cell ({thinnestCell(thinReceipts.attributed_player)} receipts).</p>
    </section>

    <section class="guide__section">
      <h2>Games</h2>
      <p class="eyebrow">The log island: which games and how many rows, both in the URL. Static here.</p>
      <Games name={top.attributed_player} log={topLog.toSorted((a, b) => b.date.localeCompare(a.date))} floor={gameFloor} top={LOG_TOP} official={threshold} />
    </section>

    <section class="guide__section">
      <h2>SectionRail</h2>
      <p class="eyebrow">Anchors down a long page; sticky as a strip, a column past 1024 px. The marked one is the section in view.</p>
      <div class="guide__stack guide__rail">
        <SectionRail
          sections={[
            { id: 'verdict', label: 'Verdict' },
            { id: 'receipts', label: 'Receipts' },
            { id: 'fans', label: 'Fans' },
            { id: 'timeline', label: 'Timeline' },
            { id: 'games', label: 'Games' },
          ]}
          current="fans"
          label="On this page (demo)"
        />
      </div>
    </section>

    <section class="guide__section">
      <h2>Mark</h2>
      <p class="eyebrow">The favicon, drawn once. A ball whose body is the sentiment bar; the header reuses the file.</p>
      <div class="guide__row">
        {
          [16, 32, 64, 128].map((px) => (
            <figure class="guide__fig">
              <img src="/favicon.svg" alt="" width={px} height={px} />
              <figcaption>{px} px</figcaption>
            </figure>
          ))
        }
        <figure class="guide__fig">
          <span class="hdr__wordmark">
            <img class="hdr__mark" src="/favicon.svg" alt="" width="28" height="28" />
            <span>Court <span class="hdr__wordmark-2">Sentiment</span></span>
          </span>
          <figcaption>the header lockup: heat, ice, the mark at cap height</figcaption>
        </figure>
      </div>
    </section>

    <section class="guide__section">
      <h2>Edge states</h2>
      <p class="eyebrow">Data the pages must render without a sentinel.</p>
      <dl class="guide__dl mono">
        <dt>No roster team</dt>
        <dd>{noRoster.attributed_player} · roster_team is null → "No roster team"</dd>
        <dt>Team FK</dt>
        <dd>{players.get(top.attributed_player)?.roster_team} · a canonical name, never an abbreviation</dd>
      </dl>
    </section>
  </main>
</Base>

