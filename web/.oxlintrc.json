{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "dist",
    ".astro",
    "src/data/types.gen.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
