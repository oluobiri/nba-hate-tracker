---
import { Leaderboard, type BoardPlayer } from '../components/Leaderboard'
import { getSeason } from '../data'
import Base from '../layouts/Base.astro'
import { countsOf } from '../lib/metrics'
import { HEADLINE_POPULATION, SITE_NAME } from '../site'

// Page 1. The board is one island; everything it needs arrives as props,
// the rule numbers straight from the manifest.
const { manifest, tables } = await getSeason()
const abbr = new Map(tables.teams.map((t) => [t.team, t.abbreviation]))
const dim = new Map(tables.players.map((p) => [p.attributed_player, p]))
const players: BoardPlayer[] = tables.player_overall.map((r) => {
  const p = dim.get(r.attributed_player)!
  return {
    ...countsOf(r),
    name: r.attributed_player,
    slug: p.slug,
    abbr: p.roster_team ? (abbr.get(p.roster_team) ?? null) : null,
    headshot: p.headshot_url,
  }
})
const headline = { count: manifest.corpus[HEADLINE_POPULATION], players: tables.players.length }
---

<Base title={SITE_NAME} description={`r/NBA's most hated players of ${manifest.season}, by negative comment rate.`}>
  <script is:inline>
    // A deep link carries a view: hold the prerendered default out of sight
    // until the island has read the URL (it removes the class).
    if (location.search) document.documentElement.classList.add('has-view')
  </script>
  <main id="main" class="wrap page">
    <header>
      <p class="eyebrow">{manifest.season} · Leaderboard</p>
      <h1 class="visually-hidden">Leaderboard</h1>
    </header>
    <Leaderboard
      client:load
      players={players}
      official={manifest.rules.qualified_threshold}
      floor={manifest.rules.floors.fanbase_min_n}
      season={manifest.season}
      headline={headline}
    />
  </main>
</Base>
