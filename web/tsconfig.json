{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["@types/node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "walk/**/*"],
  "exclude": ["dist", "node_modules"]
}
