---
import { FanbaseIndex, type FanRow } from '../components/FanbaseIndex'
import { Leaderboard, type BoardPlayer } from '../components/Leaderboard'
import { MethodNote } from '../components/MethodNote'
import { TitleTally, WeekAxis, WeeklyTitles, type TitleRow } from '../components/WeeklyTitles'
import { getSeason } from '../data'
import Base from '../layouts/Base.astro'
import { fmtInt } from '../lib/format'
import { countsOf } from '../lib/metrics'
import { weeklyHolders } from '../lib/titles'
import { HEADLINE_POPULATION, SITE_NAME } from '../site'

// Page 1. The board is one island; everything it needs arrives as props,
// the rule numbers straight from the manifest.
const { manifest, tables } = await getSeason()
const abbr = new Map(tables.teams.map((t) => [t.team, t.abbreviation]))
const dim = new Map(tables.players.map((p) => [p.attributed_player, p]))
const players: BoardPlayer[] = tables.player_overall.map((r) => {
  const p = dim.get(r.attributed_player)!
  return {
    ...countsOf(r),
    name: r.attributed_player,
    slug: p.slug,
    abbr: p.roster_team ? (abbr.get(p.roster_team) ?? null) : null,
    position: p.position,
    headshot: p.headshot_url,
  }
})
const headline = { count: manifest.corpus[HEADLINE_POPULATION], players: tables.players.length }

// Weekly titles, computed here from player_temporal; the strip is static.
const beltFloor = manifest.rules.floors.belt_min_n
const temporal: TitleRow[] = tables.player_temporal.map((r) => {
  const p = dim.get(r.attributed_player)!
  return { ...countsOf(r), week: r.week, name: r.attributed_player, slug: p.slug, headshot: p.headshot_url }
})
const weeks = [...new Set(temporal.map((r) => r.week))].toSorted()
const belt = weeklyHolders(temporal, 'neg', beltFloor)
const flowers = weeklyHolders(temporal, 'pos', beltFloor)

// The fanbase index: every flair at or above the fanbase floor.
const fanFloor = manifest.rules.floors.fanbase_min_n
const fans: FanRow[] = tables.fan_team_overall
  .filter((r) => r.comment_count >= fanFloor)
  .map((r) => ({ ...countsOf(r), abbr: r.abbreviation, name: r.fan_team, logo: r.logo_url }))
---

<Base title={SITE_NAME} description={`r/NBA's most hated players of ${manifest.season}, by negative comment rate.`}>
  <script is:inline>
    // A deep link carries a view: hold the prerendered default out of sight
    // until the island has read the URL (it removes the class).
    if (location.search) document.documentElement.classList.add('has-view')
  </script>
  <main id="main" class="wrap page">
    <header>
      <p class="eyebrow">{manifest.season} · Leaderboard</p>
      <h1 class="visually-hidden">Leaderboard</h1>
    </header>
    <Leaderboard
      client:load
      players={players}
      official={manifest.rules.qualified_threshold}
      floor={manifest.rules.floors.fanbase_min_n}
      season={manifest.season}
      headline={headline}
    />

    <section class="titles" aria-labelledby="titles-h">
      <header class="titles__head">
        <p class="eyebrow">Weekly titles · {weeks.length} weeks</p>
        <h2 id="titles-h">The Belt and the Flowers</h2>
      </header>
      <div class="wk-scroller">
        <p class="wk-scroller__label mono">The Belt · most hated that week</p>
        <WeeklyTitles metric="neg" weeks={weeks} holders={belt} label="The Belt" merge />
        <WeekAxis weeks={weeks} />
        <WeeklyTitles metric="pos" weeks={weeks} holders={flowers} label="The Flowers" merge />
        <p class="wk-scroller__label mono">The Flowers · most loved that week</p>
      </div>
      <div class="titles__tallies">
        <div class="titles__tally">
          <p class="eyebrow">The Belt · most weeks</p>
          <TitleTally holders={belt} />
        </div>
        <div class="titles__tally">
          <p class="eyebrow">The Flowers · most weeks</p>
          <TitleTally holders={flowers} />
        </div>
      </div>
      <MethodNote kind="rule">
        Each week's title goes to the highest rate among players with at least {fmtInt(beltFloor)} comments that
        week; ties go to the larger n. One rule, both titles. Cell colour follows the rate, so a weak win looks
        weak.
      </MethodNote>
    </section>

    <section class="fans" aria-labelledby="fans-h">
      <header class="titles__head">
        <p class="eyebrow">Fanbase index · {fans.length} flairs</p>
        <h2 id="fans-h">Which fans are the harshest?</h2>
      </header>
      <FanbaseIndex client:visible fans={fans} />
      <MethodNote kind="method">
        A fanbase is the flair its commenters wear, over every player they talked about. The tick is the league
        average from summed counts, never a mean of rates. Flairs with fewer than {fmtInt(fanFloor)} comments
        are left out.
      </MethodNote>
    </section>
  </main>
</Base>

<style>
  .titles,
  .fans {
    display: grid;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .titles__head {
    display: grid;
    gap: 6px;
  }
  .titles__tallies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px 32px;
  }
  .titles__tally {
    display: grid;
    gap: 8px;
  }
  .titles__tally .eyebrow {
    margin: 0;
  }
  .wk-scroller__label {
    position: sticky;
    left: 0;
    width: max-content;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
</style>
